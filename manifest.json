{
  "manifest_version": 3,
  "name": "Element Swap",
  "version": "1.2.0",
  "description": "可视化修改网页元素：一键隐藏区块、把页面图片/视频替换为 B 站或抖音视频流，规则按域名或网址保存，刷新后依然生效，数据仅存本地。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "media_referer",
        "enabled": true,
        "path": "rules/media-referer.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Element Swap",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end",
      "all_frames": false,
      "js": [
        "shared/es-shared.js",
        "content/content.js"
      ]
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/probe-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
